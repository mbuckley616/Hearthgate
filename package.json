{
  "name": "hearthgate",
  "version": "0.1.0",
  "private": true,
  "description": "Hearthgate - co-op village-and-portals dungeon crawler. Phase 0: netcode spike.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start:server": "npm run start -w server",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w shared",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test",
    "test:net": "tsx tests/reconcile-placement.ts && tsx tests/netcode-smoke.ts",
    "test:clock": "tsx tests/clock-sync.ts",
    "lab": "tsx tests/lab/run.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "colyseus.js": "^0.16.22",
    "concurrently": "^9.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
